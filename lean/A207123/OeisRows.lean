import A207123.OeisRemark

/-!
# 论文注记 3.5：行 n = 2,…,7 的经验递推对一切 k 成立（精确核对）

论文注记 3.5：「用这一判据，以精确算术核对了行 n = 2,…,7 的经验递推（A207069、A207070、A207124–A207127）对一切 k
成立」。本文件把这一句形式化：

* 判据是 `OeisRemark.lean` 的 `row_rec_of_consecutive`：常系数递推只要在 `Δ_n = (3⌈n/2⌉+1)(3⌊n/2⌋+1)` 个相邻的 `k`
  上成立，就对其后一切 `k` 成立。
* `Ucol K m` 按引理 1 逐列算出 `[U_0(m), …, U_K(m)]`（`Ucol_eq`：等于 `U` 本身，用 `lemma1`、`lemma1_one`、
  `lemma1_two`、`U_zero_left`、`U_zero_right` 证明），`rowList n K = [a_0(n), …, a_K(n)]`（`rowList_eq`，用 `a_eq`）。
  这两个函数可在内核里计算。
* `checkWindows γ w c` 在 `c` 个相邻窗口上核对 `Σ_j γ_j·w_{i+j} = 0`；`row_rec_of_check`：若它对
  `w = (rowList n K).drop k0`、`c = Δ_n` 为真，则前向递推 `Σ_j γ_j·a_{k+j}(n) = 0` 对一切 `k ≥ k0` 成立。每条
  行递推的核对用 `decide +kernel`（内核求值，不引入公理；不用 `native_decide`）。
* `oeis_A207069`、`oeis_A207070`、`oeis_A207124` … `oeis_A207127`：六条经验递推按 OEIS 原样，对一切 `n ≥ e` 成立
  （`e` 是递推的阶 10、22、28、49、55、85；`n = e` 时用到 `a_0(n) = 1`），陈述里写成 `n = k + e`。陈述与系数表由
  `code/main_extra/oeis_rows_lean.py` 从 OEIS 快照（`data/oeis/A207069.txt`、`A207070.txt`、`search_ref_A207123.txt`、
  `search_ref_A207123_p2.txt`）的 `%F … Empirical` 一行逐字生成，脚本同时在 Python 里核对。A207069、A207070 的标题
  用列规则 001/101，陈述用 `aAlt`，再由 `aAlt_two`、`aAlt_three` 换成 `a`。

本文件没有形式化的：Berlekamp–Massey 给出的阶 10、22、28、49、55、85 是最小的，以及它们等于两个因子的特征根之积中
不同值的个数（注记 3.5 的后半句；后来在 `OeisRowOrders.lean` 形式化）。
-/

namespace A207123

open Finset

/-! ## 可计算的 `U` 列 -/

/-- 由第 `m` 列算第 `m + 1` 列的一步。`ps` 是第 `m` 列从第 `k` 项起的值，`(x, y, z)` 是第 `m + 1` 列的
`(v_{k−3}, v_{k−2}, v_{k−1})`（约定 `v_{−2} = 0`、`v_{−1} = 1`），`v_k = U_k(m) + v_{k−1} + (m + 1)·v_{k−3}`（引理 1）。 -/
def colStep (m : ℕ) : List ℕ → ℕ → ℕ → ℕ → List ℕ
  | [], _, _, _ => []
  | p :: ps, x, y, z => (p + z + (m + 1) * x) :: colStep m ps y z (p + z + (m + 1) * x)

/-- `Ucol K m = [U_0(m), …, U_K(m)]`（`Ucol_eq`），可在内核里计算。 -/
def Ucol (K : ℕ) : ℕ → List ℕ
  | 0 => List.replicate (K + 1) 1
  | m + 1 => 1 :: colStep m (Ucol K m).tail 0 1 1

/-- `rowList n K = [a_0(n), …, a_K(n)]`（`rowList_eq`），`a_k(n) = U_k(⌈n/2⌉)·U_k(⌊n/2⌋)`。 -/
def rowList (n K : ℕ) : List ℕ := List.zipWith (· * ·) (Ucol K ((n + 1) / 2)) (Ucol K (n / 2))

/-- `seg f k n = [f k, f (k + 1), …, f (k + n − 1)]`（只在证明里用）。 -/
def seg (f : ℕ → ℕ) : ℕ → ℕ → List ℕ
  | _, 0 => []
  | k, n + 1 => f k :: seg f (k + 1) n

/-- 第 `m` 列向负下标的延拓：`Ushift m 0 = 0`、`Ushift m 1 = 1`（即 `U_{−2} = 0`、`U_{−1} = 1`），`Ushift m (i + 2) = U_i(m)`。 -/
def Ushift (m : ℕ) : ℕ → ℕ
  | 0 => 0
  | 1 => 1
  | i + 2 => U i m

/-- 辅助引理（注记 3.5）：引理 1 的统一写法，`k ≥ 1` 时 `U_k(m+1) = U_k(m) + v_{k−1} + (m + 1)·v_{k−3}`。 -/
theorem U_succ_eq (m : ℕ) : ∀ k, 1 ≤ k →
    U k (m + 1) = U k m + Ushift (m + 1) (k + 1) + (m + 1) * Ushift (m + 1) (k - 1)
  | 1, _ => by rw [lemma1_one]; simp [Ushift]
  | 2, _ => by rw [lemma1_two]; simp [Ushift]
  | j + 3, _ => by rw [lemma1]; simp [Ushift]

/-- 辅助引理（注记 3.5）：`colStep` 由第 `m` 列的一段算出第 `m + 1` 列的同一段。 -/
theorem colStep_eq (m : ℕ) : ∀ (n k x y z : ℕ), 1 ≤ k → x = Ushift (m + 1) (k - 1) → y = Ushift (m + 1) k →
    z = Ushift (m + 1) (k + 1) → colStep m (seg (fun i => U i m) k n) x y z = seg (fun i => U i (m + 1)) k n
  | 0, _, _, _, _, _, _, _, _ => rfl
  | n + 1, k, x, y, z, hk, hx, hy, hz => by
    have hv : U k m + z + (m + 1) * x = U k (m + 1) := by
      rw [hx, hz, U_succ_eq m k hk]
    simp only [seg, colStep, hv]
    congr 1
    exact colStep_eq m n (k + 1) y z (U k (m + 1)) (by omega) (by rw [Nat.add_sub_cancel]; exact hy) hz rfl

/-- 辅助引理（注记 3.5）：第 0 列全是 1。 -/
theorem seg_U_zero : ∀ k n, seg (fun i => U i 0) k n = List.replicate n 1
  | _, 0 => rfl
  | k, n + 1 => by rw [seg, seg_U_zero (k + 1) n, U_zero_right, List.replicate_succ]

/-- 辅助引理（注记 3.5）：`Ucol K m = [U_0(m), …, U_K(m)]`。 -/
theorem Ucol_eq (K : ℕ) : ∀ m, Ucol K m = seg (fun k => U k m) 0 (K + 1)
  | 0 => by rw [Ucol, seg_U_zero]
  | m + 1 => by
    rw [Ucol, Ucol_eq K m, seg, List.tail_cons,
      colStep_eq m K 1 0 1 1 le_rfl rfl rfl
        (by rw [show Ushift (m + 1) (1 + 1) = U 0 (m + 1) from rfl, U_zero_left]), seg, U_zero_left]

/-- 辅助引理（注记 3.5）：两段逐项相乘。 -/
theorem seg_zipWith (f g : ℕ → ℕ) : ∀ k n,
    List.zipWith (· * ·) (seg f k n) (seg g k n) = seg (fun i => f i * g i) k n
  | _, 0 => rfl
  | k, n + 1 => by simp only [seg, List.zipWith_cons_cons, seg_zipWith f g (k + 1) n]

/-- 辅助引理（注记 3.5）：`rowList n K = [a_0(n), …, a_K(n)]`。 -/
theorem rowList_eq (n K : ℕ) : rowList n K = seg (fun k => a k n) 0 (K + 1) := by
  simp only [rowList, Ucol_eq, seg_zipWith, a_eq]

/-! ## 窗口核对 -/

/-- `resid γ w = Σ_j γ_j·w_j`（`zipWith` 截到较短的一个）。 -/
def resid (γ : List ℤ) (w : List ℕ) : ℤ := (List.zipWith (fun (g : ℤ) (v : ℕ) => g * (v : ℤ)) γ w).sum

/-- 在 `c` 个相邻窗口上核对 `resid γ = 0`：第 `i` 个窗口是 `w.drop i`。 -/
def checkWindows (γ : List ℤ) : List ℕ → ℕ → Bool
  | _, 0 => true
  | w, c + 1 => (resid γ w == 0) && checkWindows γ w.tail c

/-- 辅助引理（注记 3.5）：`checkWindows` 为真，则每个窗口上 `resid γ = 0`。 -/
theorem checkWindows_spec (γ : List ℤ) : ∀ (c : ℕ) (w : List ℕ), checkWindows γ w c = true →
    ∀ i < c, resid γ (w.drop i) = 0
  | 0, _, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | c + 1, w, h, i, hi => by
    simp only [checkWindows, Bool.and_eq_true, beq_iff_eq] at h
    rcases i with _ | i
    · simpa using h.1
    · rw [← List.drop_tail]
      exact checkWindows_spec γ c w.tail h.2 i (by omega)

/-- 辅助引理（注记 3.5）：`seg` 去掉前 `i` 项。 -/
theorem drop_seg (f : ℕ → ℕ) : ∀ (i k n : ℕ), (seg f k n).drop i = seg f (k + i) (n - i)
  | 0, k, n => by simp
  | i + 1, k, 0 => by simp [seg]
  | i + 1, k, n + 1 => by
    rw [seg, List.drop_succ_cons, drop_seg f i (k + 1) n, show k + 1 + i = k + (i + 1) by omega,
      show n - i = n + 1 - (i + 1) by omega]

/-- 辅助引理（注记 3.5）：`resid γ (seg f k n) = Σ_j γ_j·f(k + j)`（`γ` 不比这一段长）。 -/
theorem resid_seg (f : ℕ → ℕ) : ∀ (γ : List ℤ) (k n : ℕ), γ.length ≤ n →
    resid γ (seg f k n) = ∑ j ∈ range γ.length, γ.getD j 0 * (f (k + j) : ℤ)
  | [], _, _, _ => by simp [resid]
  | _ :: _, _, 0, h => by simp at h
  | g :: γ, k, n + 1, h => by
    have ih := resid_seg f γ (k + 1) n (by simp at h; omega)
    simp only [resid, seg, List.zipWith_cons_cons, List.sum_cons] at ih ⊢
    rw [ih, List.length_cons, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, add_zero]
    rw [add_comm (g * ((f k : ℕ) : ℤ))]
    congr 1
    exact Finset.sum_congr rfl fun j _ => by rw [show k + 1 + j = k + (j + 1) by omega]

/-- **注记 3.5**（核对的桥）：若 `checkWindows γ ((rowList n K).drop k₀) Δ_n` 为真（`K` 足够大），则前向递推
`Σ_j γ_j·a_{k+j}(n) = 0` 对一切 `k ≥ k₀` 成立（由 `row_rec_of_consecutive`）。 -/
theorem row_rec_of_check {n K k0 : ℕ} {γ : List ℤ} (hγ : γ ≠ []) (hK : k0 + rowOrd n + γ.length ≤ K + 1)
    (hc : checkWindows γ ((rowList n K).drop k0) (rowOrd n) = true) (k : ℕ) (hk : k0 ≤ k) :
    ∑ j ∈ range γ.length, (γ.getD j 0 : ℂ) * (a (k + j) n : ℂ) = 0 := by
  obtain ⟨r, hr⟩ : ∃ r, γ.length = r + 1 := by
    cases γ with
    | nil => exact absurd rfl hγ
    | cons g γ' => exact ⟨γ'.length, rfl⟩
  rw [hr]
  refine row_rec_of_consecutive n r k0 (fun j => (γ.getD j 0 : ℂ)) (fun k' hk1 hk2 => ?_) k hk
  have hdrop : ((rowList n K).drop k0).drop (k' - k0) = (rowList n K).drop k' := by
    rw [List.drop_drop]
    congr 1
    omega
  have h1 := checkWindows_spec γ (rowOrd n) _ hc (k' - k0) (by omega)
  rw [hdrop, rowList_eq, drop_seg, resid_seg _ _ _ _ (by omega), zero_add, hr] at h1
  exact_mod_cast h1

/-- `Σ_j γ_j·f(j + j₀)` 按列表逐项展开（证明里用，展开是线性的）。 -/
noncomputable def lsumC (f : ℕ → ℂ) : List ℤ → ℕ → ℂ
  | [], _ => 0
  | g :: γ, j => (g : ℂ) * f j + lsumC f γ (j + 1)

/-- 辅助引理（注记 3.5）：`Σ_{j < |γ|} γ_j·f(j + j₀) = lsumC f γ j₀`。 -/
theorem sum_getD_eq_lsumC (f : ℕ → ℂ) : ∀ (γ : List ℤ) (j0 : ℕ),
    ∑ j ∈ range γ.length, (γ.getD j 0 : ℂ) * f (j + j0) = lsumC f γ j0
  | [], _ => by simp [lsumC]
  | g :: γ, j0 => by
    rw [lsumC, ← sum_getD_eq_lsumC f γ (j0 + 1), List.length_cons, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, zero_add]
    rw [add_comm ((g : ℂ) * f j0)]
    congr 1
    exact Finset.sum_congr rfl fun j _ => by rw [show j + 1 + j0 = j + (j0 + 1) by omega]

/-! ## 六条行递推 -/

/-- **注记 3.5**（A207069，第 n = 2 行）：OEIS 记的经验递推
`a(n) = 3*a(n-1) - 2*a(n-2) + 3*a(n-3) - 6*a(n-4) + 3*a(n-7) + a(n-8) - a(n-10)`
（A207069 的 `a(n)` 是 2×n 矩阵的个数，即这里的 `aAlt n 2`）对一切 `n ≥ 10` 成立；这里写成 `n = k + 10`（`k ≥ 0`）。 -/
theorem oeis_A207069 (k : ℕ) :
    (aAlt (k + 10) 2 : ℤ) = 3 * aAlt (k + 9) 2 - 2 * aAlt (k + 8) 2 + 3 * aAlt (k + 7) 2 - 6 * aAlt (k + 6) 2
      + 3 * aAlt (k + 3) 2 + aAlt (k + 2) 2 - aAlt k 2 := by
  have h := (sum_getD_eq_lsumC (fun j => (a (k + j) 2 : ℂ)) _ 0).symm.trans
    (row_rec_of_check (n := 2) (K := 26) (k0 := 0) (γ := [1, 0, -1, -3, 0, 0, 6, -3, 2, -3, 1]) (by decide)
      (by norm_num [rowOrd]) (by decide +kernel) k (Nat.zero_le k))
  simp only [lsumC, add_zero] at h
  push_cast at h
  simp only [aAlt_two]
  apply Int.cast_injective (α := ℂ)
  push_cast
  linear_combination h

