g\/10.1523\/eneuro.0394-22.2023.video.1"},{"DOI":"10.4324\/9780203124451-15","title":["Vertically and horizontally integrated supply chains"],"issued":{"date-parts":[[2013,5,2]]},"container-title":["Strategic Supply Chain Management"],"type":"book-chapter","is-referenced-by-count":0,"URL":"https:\/\/doi.org\/10.4324\/9780203124451-15"},{"abstract":"<jats:p>This paper experimentally examines whether a decoy, which is dominated by a target but not by an outside option, affects choices differently between product types. When the target and decoy products are vertically differentiated, we find evidence of the dominance effect, and the decoy is rarely chosen. However, when they are horizontally differentiated, the decoy is chosen as often as the target once their prices become equal. This implies the limitation of the dominance effect for horizontally differentiated products. A further model selection exercise shows that the pairwise normalization model has better out-of-sample predictions than the range normalization model.<\/jats:p>","DOI":"10.2139\/ssrn.6760341","type":"posted-content","is-referenced-by-count":0,"title":["An Experiment on Decoy Effects for Vertically and Horizontally Differentiated Products"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-6892-3886","authenticated-orcid":true,"given":"Changkuk","family":"Im","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"issued":{"date-parts":[[2026]]},"URL":"https:\/\/doi.org\/10.2139\/ssrn.6760341"},{"DOI":"10.31390\/gradschool_theses.1279","title":["Computing moments of a binary horizontally\/vertically convex image using run-time reconfiguration"],"author":[{"sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Cheowway","family":"Neoh","sequence":"first","affiliation":[{"name":"Louisiana State University and Agricultural and Mechanical College"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"issued":{"date-part